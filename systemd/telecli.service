[Unit]
Description=Telegram User Download Daemon
After=network.target

[Service]
Type=simple
User=decko
Group=decko
WorkingDirectory=/home/decko/dev/go-user-tele-downloader
ExecStart=/home/decko/dev/go-user-tele-downloader/bin/telecli start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telecli

# Environment variables (load from .env file)
EnvironmentFile=/home/decko/dev/go-user-tele-downloader/.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/decko/dev/go-user-tele-downloader/downloads

[Install]
WantedBy=multi-user.target
