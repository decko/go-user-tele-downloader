# MTProto authentication (required)
# Get your API credentials from https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890

# 2FA password (optional, only if your account has 2FA enabled)
# TELEGRAM_PASSWORD=your_2fa_password

# Session file path (encrypted session storage)
SESSION_PATH=./session.enc

# Channels to monitor for downloads (comma-separated channel IDs)
# Use negative numbers for channels (e.g., -1001234567890)
MONITOR_CHANNELS=-1001234567890,-1009876543210

# Download directory (optional, defaults to ./downloads)
DOWNLOAD_DIR=./downloads

# Database path (optional, defaults to ./tele-downloader.db)
DATABASE_PATH=./tele-downloader.db

# Max concurrent downloads (optional, defaults to 3)
MAX_CONCURRENT_DOWNLOADS=3

# Log level (optional, defaults to info)
LOG_LEVEL=info
