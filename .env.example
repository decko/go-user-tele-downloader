# MTProto authentication (required)
# Get your API credentials from https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890

# 2FA password (optional, only if your account has 2FA enabled)
# If set, this will also be used to encrypt the session file
# TELEGRAM_PASSWORD=your_2fa_password

# Session encryption password (required if 2FA is not enabled)
# Used to encrypt the session file for secure storage
# SESSION_ENCRYPTION_PASSWORD=your_encryption_password

# Verification code for headless authentication (optional)
# If set, the bot will use this code instead of prompting interactively
# TELEGRAM_VERIFICATION_CODE=12345

# Session file path (encrypted session storage)
SESSION_PATH=./session.enc

# Channels to monitor for downloads (comma-separated channel IDs)
# Use negative numbers for channels (e.g., -1001234567890)
MONITOR_CHANNELS=-1001234567890,-1009876543210

# Content-type routing (optional). Disjoint subsets of MONITOR_CHANNELS.
# When both are empty, all monitored channels route to Radarr (backward compat).
# MOVIE_CHANNELS=-1001234567890
# TV_CHANNELS=-1009876543210

# Download directory (optional, defaults to ./downloads)
DOWNLOAD_DIR=./downloads

# Database path (optional, defaults to ./tele-downloader.db)
DATABASE_PATH=./tele-downloader.db

# Max concurrent downloads (optional, defaults to 3)
MAX_CONCURRENT_DOWNLOADS=3

# Log level (optional, defaults to info)
LOG_LEVEL=info

# ── Radarr integration (optional) ──────────────────────────────────
# When configured, completed downloads from MOVIE_CHANNELS (or, if no
# routing is configured, all monitored channels) are automatically looked
# up, added, and imported into Radarr. Omit these to disable the feature.
# RADARR_URL=http://localhost:7878
# RADARR_API_KEY=your_radarr_api_key
# RADARR_ROOT_FOLDER=/media/movies
# RADARR_QUALITY_PROFILE_ID=1
#
# Strict mode: only import when the filename matches a movie exactly
# (title AND year). Recommended to avoid importing wrong movies.
# RADARR_IMPORT_STRICT=true
#
# ── Sonarr integration (optional) ──────────────────────────────────
# When configured, completed downloads from TV_CHANNELS are automatically
# looked up, added, and imported into Sonarr. Mirror of the RADARR_* block.
# SONARR_URL=http://localhost:8989
# SONARR_API_KEY=your_sonarr_api_key
# SONARR_ROOT_FOLDER=/media/tv
# SONARR_QUALITY_PROFILE_ID=1
# SONARR_IMPORT_STRICT=false
#
# Per-file opt-out: append #noimport to the channel message caption
# to download a file without importing it into Radarr or Sonarr.
